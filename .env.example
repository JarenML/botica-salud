# Credenciales de Postgres para docker-compose-dev.yml.
# Copia este archivo a `.env` (en la raíz del repo). Si no existe, se usan estos mismos valores por defecto.
# Nota: Postgres solo lee estas variables al crear el volumen por primera vez.
# Si las cambias después, borra el volumen: docker compose -f docker-compose-dev.yml down -v
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=botica_salud
