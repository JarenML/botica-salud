# Servidor
PORT=3000

# Autenticacion
JWT_SECRET=change_this_secret

# Base de datos (PostgreSQL)
# Esta URL se usa al ejecutar el backend o los comandos de Prisma desde tu máquina
# (Postgres de Docker expuesto en el puerto 5433). Debe coincidir con el `.env` de la raíz.
# Dentro de Docker, docker-compose-dev.yml la sobrescribe para apuntar al servicio `postgres`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/botica_salud?schema=public
