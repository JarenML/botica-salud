generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model categoria {
  id_categoria       Int        @id @default(autoincrement())
  nombre             String     @unique @db.VarChar(50)
  descripcion        String?    @db.VarChar(255)
  fecha_creacion     DateTime?  @default(now()) @db.Timestamp(6)
  fecha_actualizacion DateTime? @updatedAt @db.Timestamp(6)
  producto           producto[]
}

model cliente {
  id_cliente       Int       @id @default(autoincrement())
  dni              String?   @unique @db.VarChar(20)
  nombre           String    @db.VarChar(50)
  apellido         String    @db.VarChar(50)
  telefono         String?   @db.VarChar(15)
  email            String    @unique @db.VarChar(100)
  direccion        String?   @db.VarChar(255)
  fecha_nacimiento DateTime? @db.Date
  fecha_creacion   DateTime? @default(now()) @db.Timestamp(6)
  venta            venta[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model detalle_venta {
  id_detalle      Int       @id @default(autoincrement())
  venta_id        Int
  producto_id     Int
  cantidad        Int
  precio_unitario Decimal   @db.Decimal(10, 2)
  subtotal        Decimal   @db.Decimal(12, 2)
  fecha_creacion  DateTime? @default(now()) @db.Timestamp(6)
  producto        producto  @relation(fields: [producto_id], references: [id_producto], onDelete: NoAction, onUpdate: NoAction)
  venta           venta     @relation(fields: [venta_id], references: [id_venta], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model producto {
  id_producto       Int             @id @default(autoincrement())
  codigo            String?         @unique @db.VarChar(20)
  nombre            String          @db.VarChar(150)
  imagen            String?         @db.VarChar(255)
  descripcion       String?
  precio_venta      Decimal         @db.Decimal(10, 2)
  precio_compra     Decimal         @db.Decimal(10, 2)
  categoria_id      Int
  proveedor_id      Int
  fecha_vencimiento DateTime        @db.Date
  requiere_receta   Boolean?        @default(false)
  stock_actual      Int             @default(0)
  stock_minimo      Int             @default(5)
  ubicacion         String?         @db.VarChar(255)
  fecha_creacion    DateTime?       @default(now()) @db.Timestamp(6)
  detalle_venta     detalle_venta[]
  categoria         categoria       @relation(fields: [categoria_id], references: [id_categoria], onDelete: NoAction, onUpdate: NoAction)
  proveedor         proveedor       @relation(fields: [proveedor_id], references: [id_proveedor], onDelete: NoAction, onUpdate: NoAction)
}

model proveedor {
  id_proveedor   Int        @id @default(autoincrement())
  nombre         String     @db.VarChar(100)
  telefono       String     @db.VarChar(20)
  email          String     @unique @db.VarChar(100)
  direccion      String?    @db.VarChar(255)
  ruc            String     @db.VarChar(20)
  fecha_creacion DateTime?  @default(now()) @db.Timestamp(6)
  producto       producto[]
}

model usuario {
  id_usuario     Int         @id @default(autoincrement())
  nombre         String      @db.VarChar(50)
  apellidos      String      @db.VarChar(50)
  email          String      @unique @db.VarChar(100)
  username       String      @unique @db.VarChar(70)
  password       String      @db.VarChar(255)
  rol            rol_usuario
  fecha_creacion DateTime?   @default(now()) @db.Timestamp(6)
  venta          venta[]
}

model venta {
  id_venta       Int             @id @default(autoincrement())
  codigo_venta   String?         @unique @db.VarChar(15)
  usuario_id     Int
  cliente_id     Int
  total          Decimal         @db.Decimal(12, 2)
  metodo_pago    metodo_pago
  estado         estado_venta?
  observaciones  String?         @db.VarChar(255)
  fecha_creacion DateTime?       @default(now()) @db.Timestamp(6)
  detalle_venta  detalle_venta[]
  cliente        cliente         @relation(fields: [cliente_id], references: [id_cliente], onDelete: NoAction, onUpdate: NoAction)
  usuario        usuario         @relation(fields: [usuario_id], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
}

enum estado_venta {
  pendiente
  pagado
  anulado
}

enum metodo_pago {
  efectivo
  tarjeta_credito
  tarjeta_debito
  transferencia
  otros
}

enum rol_usuario {
  admin
  farmaceutico
  cajero
}
